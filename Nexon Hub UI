		Name = "CornerPatch",
		Position = UDim2.new(1, -12, 0, 0),
		Size = UDim2.new(0, 12, 1, 0),
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		Parent = sidebar,
	})

	-- Brand
	local brand = create("Frame", {
		Name = "Brand",
		Size = UDim2.new(1, 0, 0, TOPBAR_HEIGHT),
		BackgroundTransparency = 1,
		Parent = sidebar,
	})

	local brandDot = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0, Parent = brand,
	})
	corner(brandDot, 4)

	local brandLabel = create("TextLabel", {
		Position = UDim2.new(0, 30, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.new(1, -38, 1, 0),
		BackgroundTransparency = 1,
		Font = theme.FontBold,
		Text = Options.Title,
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = brand,
	})

	-- Tab list
	local tabList = create("ScrollingFrame", {
		Name = "TabList",
		Position = UDim2.fromOffset(0, TOPBAR_HEIGHT),
		Size = UDim2.new(1, 0, 1, -TOPBAR_HEIGHT),
		BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, ScrollBarImageColor3 = theme.Stroke,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = sidebar,
	})
	padding(tabList, 8, 8, 8, 8)
	create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tabList })

	-- Topbar
	local topbar = create("Frame", {
		Name = "Topbar",
		Position = UDim2.fromOffset(SIDEBAR_WIDTH, 0),
		Size = UDim2.new(1, -SIDEBAR_WIDTH, 0, TOPBAR_HEIGHT),
		BackgroundTransparency = 1,
		Parent = main,
	})

	local tabTitle = create("TextLabel", {
		Position = UDim2.fromOffset(18, 0),
		Size = UDim2.new(1, -120, 1, 0),
		BackgroundTransparency = 1,
		Font = theme.FontBold,
		Text = "",
		TextColor3 = theme.Text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = topbar,
	})

	-- Controls
	local controls = create("Frame", {
		Name = "Controls",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(60, 24),
		BackgroundTransparency = 1,
		Parent = topbar,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = controls,
	})

	local function makeControl(order, symbol, hoverColor)
		local b = create("TextButton", {
			Size = UDim2.fromOffset(24, 24),
			BackgroundColor3 = theme.Element,
			BorderSizePixel = 0,
			Text = symbol,
			Font = theme.FontBold,
			TextColor3 = theme.SubText,
			TextSize = 14,
			AutoButtonColor = false,
			LayoutOrder = order,
			Parent = controls,
		})
		corner(b, 6)
		track(b.MouseEnter:Connect(function()
			tween(b, 0.15, { BackgroundColor3 = hoverColor, TextColor3 = Library.Themes[Library.ActiveTheme].Text })
		end))
		track(b.MouseLeave:Connect(function()
			tween(b, 0.15, { BackgroundColor3 = Library.Themes[Library.ActiveTheme].Element, TextColor3 = Library.Themes[Library.ActiveTheme].SubText })
		end))
		return b
	end

	local minimizeBtn = makeControl(1, "—", theme.ElementHover)
	local closeBtn    = makeControl(2, "×", theme.Red)

	-- Content
	local content = create("Frame", {
		Name = "Content",
		Position = UDim2.fromOffset(SIDEBAR_WIDTH, TOPBAR_HEIGHT),
		Size = UDim2.new(1, -SIDEBAR_WIDTH, 1, -TOPBAR_HEIGHT),
		BackgroundTransparency = 1,
		Parent = main,
	})

	-- Theme painter for window chrome
	paint(function(t)
		main.BackgroundColor3 = t.Background
		mainStroke.Color = t.Stroke
		sidebar.BackgroundColor3 = t.Surface
		cornerPatch.BackgroundColor3 = t.Surface
		brandDot.BackgroundColor3 = t.Accent
		brandLabel.Font = t.FontBold; brandLabel.TextColor3 = t.Text
		tabTitle.Font = t.FontBold; tabTitle.TextColor3 = t.Text
		tabList.ScrollBarImageColor3 = t.Stroke
		minimizeBtn.BackgroundColor3 = t.Element; minimizeBtn.TextColor3 = t.SubText
		closeBtn.BackgroundColor3 = t.Element; closeBtn.TextColor3 = t.SubText
	end)

	--==========================================================
	local Window = {
		Name = Options.Title,
		Tabs = {},
		CurrentTab = nil,
		ScreenGui = screenGui,
		Main = main,
	}

	local function selectTab(index)
		local tab = Window.Tabs[index]
		if not tab then return end
		for i, t in ipairs(Window.Tabs) do
			local active = (i == index)
			t.Container.Visible = active
			tween(t.Button, 0.18, { BackgroundTransparency = active and 0 or 1 })
			tween(t.Indicator, 0.18, { Size = UDim2.new(0, 3, 0, active and 16 or 0) })
			tween(t.Label, 0.18, { TextColor3 = active and Library.Themes[Library.ActiveTheme].Text
				or Library.Themes[Library.ActiveTheme].SubText })
		end
		Window.CurrentTab = index
		tabTitle.Text = tab.Name
	end

	function Window:CreateTab(name)
		name = name or "Tab"
		local index = #self.Tabs + 1
		local theme = Library.Themes[Library.ActiveTheme]

		local container = create("ScrollingFrame", {
			Name = name .. "Container",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
			ScrollBarThickness = 4, ScrollBarImageColor3 = theme.Stroke, ScrollBarImageTransparency = 0.4,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Parent = content,
		})
		padding(container, 12, 12, 12, 12)
		create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = container })

		local button = create("TextButton", {
			Name = name .. "Button",
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundColor3 = theme.SurfaceHover,
			BackgroundTransparency = 1,
			BorderSizePixel = 0, Text = "",
			AutoButtonColor = false, LayoutOrder = index, Parent = tabList,
		})
		corner(button, 8)

		local indicator = create("Frame", {
			Name = "Indicator",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.new(0, 3, 0, 0),
			BackgroundColor3 = theme.Accent, BorderSizePixel = 0, Parent = button,
		})
		corner(indicator, 2)

		local label = create("TextLabel", {
			Position = UDim2.fromOffset(16, 0),
			Size = UDim2.new(1, -20, 1, 0),
			BackgroundTransparency = 1,
			Font = theme.FontMedium,
			Text = name,
			TextColor3 = theme.SubText,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = button,
		})

		paint(function(t)
			container.ScrollBarImageColor3 = t.Stroke
			button.BackgroundColor3 = t.SurfaceHover
			indicator.BackgroundColor3 = t.Accent
			label.Font = t.FontMedium
			if Window.CurrentTab ~= index then label.TextColor3 = t.SubText end
		end)

		track(button.MouseEnter:Connect(function()
			if Window.CurrentTab ~= index then tween(button, 0.15, { BackgroundTransparency = 0.55 }) end
		end))
		track(button.MouseLeave:Connect(function()
			if Window.CurrentTab ~= index then tween(button, 0.15, { BackgroundTransparency = 1 }) end
		end))

		local counter = 0
		local tab = setmetatable({
			Name = name, Index = index, Button = button, Label = label,
			Indicator = indicator, Container = container,
			NextOrder = function() counter += 1; return counter end,
		}, Tab)

		table.insert(self.Tabs, tab)
		track(button.MouseButton1Click:Connect(function() selectTab(index) end))
		if index == 1 then selectTab(1) end
		return tab
	end

	function Window:SelectTab(index)
		if type(index) == "string" then
			for i, t in ipairs(self.Tabs) do
				if t.Name == index then selectTab(i); return end
			end
			return
		end
		selectTab(index)
	end

	function Window:Toggle(state)
		if state == nil then state = not main.Visible end
		main.Visible = state
	end

	function Window:Destroy()
		if Options.SaveConfig then Library:SaveConfig(Options.ConfigPath) end
		screenGui:Destroy()
		if Options.BlurBackground then Library:SetBlur(false) end
		for i, w in ipairs(Library.Windows) do
			if w == self then table.remove(Library.Windows, i); break end
		end
	end

	--==========================================================
	--  DRAGGING (topbar)
	--==========================================================
	local dragging, dragStart, startPos
	track(topbar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end))

	track(UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end))

	--==========================================================
	--  RESIZE
	--==========================================================
	if Options.Resizable then
		local resizer = create("TextButton", {
			Name = "Resizer",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -2, 1, -2),
			Size = UDim2.fromOffset(14, 14),
			BackgroundTransparency = 1,
			Text = "", AutoButtonColor = false,
			Parent = main,
		})
		local resizing, resizeStart, startSize

		track(resizer.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				resizing = true
				resizeStart = input.Position
				startSize = main.AbsoluteSize
			end
		end))

		track(UserInputService.InputChanged:Connect(function(input)
			if not resizing then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				local delta = input.Position - resizeStart
				local w = math.clamp(startSize.X + delta.X, 400, 1400)
				local h = math.clamp(startSize.Y + delta.Y, 260, 900)
				main.Size = UDim2.fromOffset(w, h)
				Options.Size = UDim2.fromOffset(w, h)
			end
		end))

		track(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then resizing = false end
		end))
	end

	--==========================================================
	--  MINIMIZE / CLOSE
	--==========================================================
	local minimized = false
	local function setMinimized(state)
		minimized = state
		sidebar.Visible = not state
		content.Visible = not state
		if state then
			tween(main, 0.22, { Size = UDim2.new(0, Options.Size.X.Offset, 0, TOPBAR_HEIGHT) })
			tween(topbar, 0.22, { Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, TOPBAR_HEIGHT) })
		else
			tween(main, 0.22, { Size = Options.Size })
			tween(topbar, 0.22, { Position = UDim2.fromOffset(SIDEBAR_WIDTH, 0), Size = UDim2.new(1, -SIDEBAR_WIDTH, 0, TOPBAR_HEIGHT) })
		end
	end

	track(minimizeBtn.MouseButton1Click:Connect(function() setMinimized(not minimized) end))
	track(closeBtn.MouseButton1Click:Connect(function() Window:Destroy() end))

	--==========================================================
	--  TOGGLE KEY
	--==========================================================
	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == Options.ToggleKey then
			main.Visible = not main.Visible
		end
	end))

	--==========================================================
	--  CONFIG LOAD
	--==========================================================
	if Options.SaveConfig then self:LoadConfig(Options.ConfigPath) end

	table.insert(self.Windows, Window)
	return Window
end

--==================================================================
--  GLOBAL CLEANUP
--==================================================================
function Library:Destroy()
	for _, conn in ipairs(self._connections) do
		pcall(function() conn:Disconnect() end)
	end
	self._connections = {}
	for _, obj in ipairs(self._destroyers) do
		pcall(function() obj:Destroy() end)
	end
	self._destroyers = {}
	self._painters = {}
	self.Windows = {}
	self.Flags = {}
	self:SetBlur(false)
	if tooltipGui then tooltipGui:Destroy(); tooltipGui = nil end
end

--==================================================================
--  INIT DEFAULT THEME
--==================================================================
Library:SetTheme("Midnight")

return Library
