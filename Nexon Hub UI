function Section:CreateRadioGroup(cfg)
	cfg = cfg or {}
	local theme = getTheme()
	local options = cfg.Options or {}
	local selected = cfg.Default or options[1]

	local container = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, LayoutOrder = self.NextOrder(), Parent = self.Container,
	})
	create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = container })
	create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
		Font = theme.FontBold, Text = cfg.Name or "Options",
		TextColor3 = theme.Text, TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 0, Parent = container,
	})

	local dots = {}
	local inners = {}
	local function setSelection(option, silent)
		selected = option
		for opt, dot in pairs(dots) do
			local active = (opt == selected)
			dot.BackgroundColor3 = active and getTheme().Accent or getTheme().Element
			tween(inners[opt], 0.15, { BackgroundTransparency = active and 0 or 1 })
		end
		if cfg.Flag then Library.Flags[cfg.Flag] = selected end
		if not silent and cfg.Callback then task.spawn(cfg.Callback, selected) end
	end

	for i, option in ipairs(options) do
		local optRow = create("Frame", {
			Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1,
			LayoutOrder = i, Parent = container,
		})
		local dot = create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = (option == selected) and theme.Accent or theme.Element,
			BorderSizePixel = 0, Parent = optRow,
		})
		corner(dot, 7)
		stroke(dot, theme.Stroke, 1, 0.4)
		local innerDot = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(6, 6), BackgroundColor3 = Color3.fromRGB(255,255,255),
			BackgroundTransparency = (option == selected) and 0 or 1,
			BorderSizePixel = 0, Parent = dot,
		})
		corner(innerDot, 3)
		create("TextLabel", {
			Position = UDim2.fromOffset(22, 0),
			Size = UDim2.new(1, -22, 1, 0), BackgroundTransparency = 1,
			Font = theme.Font, Text = tostring(option),
			TextColor3 = theme.Text, TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left, Parent = optRow,
		})
		local hitbox = create("TextButton", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			Text = "", AutoButtonColor = false, Parent = optRow,
		})
		dots[option] = dot
		inners[option] = innerDot
		track(hitbox.MouseButton1Click:Connect(function() setSelection(option) end))
	end

	paint(function(t)
		for opt, dot in pairs(dots) do
			dot.BackgroundColor3 = (opt == selected) and t.Accent or t.Element
		end
	end)

	local obj = { Instance = container }
	function obj:Set(v) setSelection(v) end
	function obj:Get() return selected end
	function obj:SetVisible(v) container.Visible = v end
	return obj
end

