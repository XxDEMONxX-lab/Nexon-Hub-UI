Library._blur = nil
function Library:SetBlur(enabled, size)
	if enabled then
		if not self._blur then
			self._blur = create("BlurEffect", { Name = "NexonHubBlur", Size = size or 14, Parent = Lighting })
		else
			self._blur.Size = size or 14
		end
	else
		if self._blur then self._blur:Destroy(); self._blur = nil end
	end
end

