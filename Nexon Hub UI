function Section:CreateColorPicker(cfg)
	cfg = cfg or {}
	local theme = getTheme()
	local color = cfg.Default or Color3.fromRGB(124, 92, 255)
	local h, s, v = Color3.toHSV(color)

	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1,
		LayoutOrder = self.NextOrder(), Parent = self.Container,
	})
	local lbl = create("TextLabel", {
		Size = UDim2.new(1, -80, 1, 0), BackgroundTransparency = 1,
		Font = theme.Font, Text = cfg.Name or "Color",
		TextColor3 = theme.Text, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
	local swatch = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(60, 22), BackgroundColor3 = color,
		BorderSizePixel = 0, Text = "", AutoButtonColor = false, Parent = row,
	})
	corner(swatch, 6)
	stroke(swatch, theme.Stroke, 1, 0.4)
	paint(function(t)
		lbl.Font = t.Font; lbl.TextColor3 = t.Text
	end)

	local popup, overlay
	local function close()
		if popup then popup:Destroy(); popup = nil end
		if overlay then overlay:Destroy(); overlay = nil end
	end
	local function fire()
		if cfg.Flag then Library.Flags[cfg.Flag] = color end
		if cfg.Callback then task.spawn(cfg.Callback, color) end
	end

	local function open()
		close()
		local t = getTheme()
		local parentGui = swatch:FindFirstAncestorOfClass("ScreenGui") or Library.ActiveScreenGui
		overlay = create("TextButton", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			Text = "", AutoButtonColor = false, ZIndex = 998, Parent = parentGui,
		})
		overlay.MouseButton1Click:Connect(close)

		local popupW, popupH = 250, 210
		local screenW = parentGui.AbsoluteSize.X
		local px = math.clamp(swatch.AbsolutePosition.X - popupW + swatch.AbsoluteSize.X, 10, screenW - popupW - 10)
		local py = swatch.AbsolutePosition.Y + swatch.AbsoluteSize.Y + 4

		popup = create("Frame", {
			Position = UDim2.fromOffset(px, py),
			Size = UDim2.fromOffset(popupW, popupH),
			BackgroundColor3 = t.Surface, BorderSizePixel = 0,
			ZIndex = 999, Parent = parentGui,
		})
		corner(popup, 10)
		stroke(popup, t.Stroke, 1, 0.3)
		padding(popup, 12, 12, 12, 12)

		local hueBar = create("Frame", {
			Position = UDim2.fromOffset(0, 0),
			Size = UDim2.new(1, -70, 0, 14),
			BackgroundColor3 = Color3.fromRGB(255,255,255),
			BorderSizePixel = 0, Parent = popup,
		})
		corner(hueBar, 7)
		create("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,0,0)),
				ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,255,0)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
				ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0,255,255)),
				ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0,0,255)),
				ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
				ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255,0,0)),
			}), Parent = hueBar,
		})
		local hueKnob = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(h, 0, 0.5, 0),
			Size = UDim2.fromOffset(6, 20), BackgroundColor3 = Color3.fromRGB(255,255,255),
			BorderSizePixel = 0, ZIndex = 2, Parent = hueBar,
		})
		corner(hueKnob, 3)
		stroke(hueKnob, t.Background, 2, 0)

		local svArea = create("Frame", {
			Position = UDim2.fromOffset(0, 22),
			Size = UDim2.new(1, -70, 0, 120),
			BackgroundColor3 = Color3.fromHSV(h, 1, 1),
			BorderSizePixel = 0, Parent = popup,
		})
		corner(svArea, 6)
		local whiteOverlay = create("Frame", {
			Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255,255,255),
			BorderSizePixel = 0, ZIndex = 1, Parent = svArea,
		})
		corner(whiteOverlay, 6)
		create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}), Parent = whiteOverlay,
		})
		local blackOverlay = create("Frame", {
			Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(0,0,0),
			BorderSizePixel = 0, ZIndex = 2, Parent = svArea,
		})
		corner(blackOverlay, 6)
		create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0),
			}), Parent = blackOverlay,
		})
		local svKnob = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(s, 0, 1 - v, 0),
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = color, BorderSizePixel = 0,
			ZIndex = 3, Parent = svArea,
		})
		corner(svKnob, 6)
		stroke(svKnob, Color3.fromRGB(255,255,255), 2, 0)

		local preview = create("Frame", {
			Position = UDim2.new(1, -60, 0, 22), Size = UDim2.fromOffset(60, 50),
			BackgroundColor3 = color, BorderSizePixel = 0, Parent = popup,
		})
		corner(preview, 6)
		stroke(preview, t.Stroke, 1, 0.3)

		local hexBox = create("TextBox", {
			Position = UDim2.new(1, -60, 0, 78), Size = UDim2.fromOffset(60, 24),
			BackgroundColor3 = t.Element, BorderSizePixel = 0,
			Font = t.Font, Text = "#" .. color:ToHex(),
			TextColor3 = t.Text, TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Center,
			ClearTextOnFocus = false, Parent = popup,
		})
		corner(hexBox, 6)

		local applyBtn = create("TextButton", {
			Position = UDim2.new(1, -60, 0, 108), Size = UDim2.fromOffset(60, 22),
			BackgroundColor3 = t.Accent, BorderSizePixel = 0,
			Text = "Apply", Font = t.FontBold,
			TextColor3 = Color3.fromRGB(255,255,255), TextSize = 11,
			AutoButtonColor = false, Parent = popup,
		})
		corner(applyBtn, 6)

		local function setColor(newColor, silent)
			color = newColor
			h, s, v = Color3.toHSV(color)
			swatch.BackgroundColor3 = color
			preview.BackgroundColor3 = color
			svArea.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
			svKnob.BackgroundColor3 = color
			hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
			hexBox.Text = "#" .. color:ToHex()
			if not silent then fire() end
		end

		local draggingHue, draggingSV = false, false
		track(hueBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				draggingHue = true
				local rel = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1), 0, 1)
				setColor(Color3.fromHSV(rel, s, v))
			end
		end))
		track(svArea.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				draggingSV = true
				local sx = math.clamp((input.Position.X - svArea.AbsolutePosition.X) / math.max(svArea.AbsoluteSize.X, 1), 0, 1)
				local vy = math.clamp((input.Position.Y - svArea.AbsolutePosition.Y) / math.max(svArea.AbsoluteSize.Y, 1), 0, 1)
				setColor(Color3.fromHSV(h, sx, 1 - vy))
			end
		end))
		local moveConn = UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseMovement
				and input.UserInputType ~= Enum.UserInputType.Touch then return end
			if draggingHue then
				local rel = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1), 0, 1)
				setColor(Color3.fromHSV(rel, s, v))
			elseif draggingSV then
				local sx = math.clamp((input.Position.X - svArea.AbsolutePosition.X) / math.max(svArea.AbsoluteSize.X, 1), 0, 1)
				local vy = math.clamp((input.Position.Y - svArea.AbsolutePosition.Y) / math.max(svArea.AbsoluteSize.Y, 1), 0, 1)
				setColor(Color3.fromHSV(h, sx, 1 - vy))
			end
		end)
		local endConn = UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				draggingHue, draggingSV = false, false
			end
		end)
		overlay.Destroying:Connect(function()
			moveConn:Disconnect()
			endConn:Disconnect()
		end)

		track(hexBox.FocusLost:Connect(function()
			local txt = hexBox.Text:gsub("#", "")
			local ok, c = pcall(Color3.fromHex, txt)
			if ok then setColor(c) else hexBox.Text = "#" .. color:ToHex() end
		end))
		track(applyBtn.MouseButton1Click:Connect(function() fire(); close() end))
	end

	track(swatch.MouseButton1Click:Connect(function()
		if popup then close() else open() end
	end))
	attachTooltip(swatch, cfg.Tooltip)

	local obj = { Instance = swatch }
	function obj:Set(c) color = c; swatch.BackgroundColor3 = c; fire() end
	function obj:Get() return color end
	function obj:SetVisible(vv) row.Visible = vv end
	return obj
end

