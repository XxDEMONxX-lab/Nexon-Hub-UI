		BackgroundTransparency = 1,
		Font = theme.Font,
		Text = cfg.Name or "Progress",
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local valueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(70, 16),
		BackgroundTransparency = 1,
		Font = theme.FontMedium,
		Text = "0%",
		TextColor3 = theme.SubText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	local bar = create("Frame", {
		Position = UDim2.new(0, 0, 0, 22),
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		Parent = row,
	})
	corner(bar, 4)

	local fill = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = cfg.Color or theme.Accent,
		BorderSizePixel = 0,
		Parent = bar,
	})
	corner(fill, 4)

	paint(function(t)
		lbl.Font = t.Font; lbl.TextColor3 = t.Text
		valueLabel.Font = t.FontMedium; valueLabel.TextColor3 = t.SubText
		bar.BackgroundColor3 = t.Element
		fill.BackgroundColor3 = cfg.Color or t.Accent
	end)

	local function update(v)
		value = math.clamp(v, min, max)
		local alpha = (max - min == 0) and 0 or (value - min) / (max - min)
		tween(fill, 0.25, { Size = UDim2.new(alpha, 0, 1, 0) })
		valueLabel.Text = string.format("%d%%", math.floor(alpha * 100 + 0.5))
	end

	update(value)

	local obj = { Instance = bar }
	function obj:Set(v) update(v) end
	function obj:Get() return value end
	function obj:SetVisible(v) row.Visible = v end
	return obj
end

function Section:CreateRadioGroup(cfg)
	cfg = cfg or {}
	local theme = Library.Themes[Library.ActiveTheme]
	local options = cfg.Options or {}
	local selected = cfg.Default or options[1]

	local container = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = self.NextOrder(),
		Parent = self.Container,
	})
	create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = container })

	create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		Font = theme.FontBold,
		Text = cfg.Name or "Options",
		TextColor3 = theme.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 0,
		Parent = container,
	})

	local dots = {}

	local function setSelection(option, silent)
		selected = option
		for opt, dot in pairs(dots) do
			local active = (opt == selected)
			dot.BackgroundColor3 = active and Library.Themes[Library.ActiveTheme].Accent
				or Library.Themes[Library.ActiveTheme].Element
		end
		if cfg.Flag then Library.Flags[cfg.Flag] = selected end
		if not silent and cfg.Callback then task.spawn(cfg.Callback, selected) end
	end

	for i, option in ipairs(options) do
		local optRow = create("Frame", {
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundTransparency = 1,
			LayoutOrder = i,
			Parent = container,
		})

		local dot = create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = (option == selected) and theme.Accent or theme.Element,
			BorderSizePixel = 0,
			Parent = optRow,
		})
		corner(dot, 7)
		stroke(dot, theme.Stroke, 1, 0.4)

		local innerDot = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(6, 6),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = (option == selected) and 0 or 1,
			BorderSizePixel = 0,
			Parent = dot,
		})
		corner(innerDot, 3)

		create("TextLabel", {
			Position = UDim2.fromOffset(22, 0),
			Size = UDim2.new(1, -22, 1, 0),
			BackgroundTransparency = 1,
			Font = theme.Font,
			Text = tostring(option),
			TextColor3 = theme.Text,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = optRow,
		})

		local hitbox = create("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Parent = optRow,
		})

		dots[option] = dot
		track(hitbox.MouseButton1Click:Connect(function()
			setSelection(option)
			for _, d in pairs(dots) do
				for _, child in ipairs(d:GetChildren()) do
					if child:IsA("Frame") then
						tween(child, 0.15, { BackgroundTransparency = (d == dot) and 0 or 1 })
					end
				end
			end
		end))
	end

	paint(function(t)
		for opt, dot in pairs(dots) do
			dot.BackgroundColor3 = (opt == selected) and t.Accent or t.Element
		end
	end)

	local obj = { Instance = container }
	function obj:Set(v) setSelection(v) end
	function obj:Get() return selected end
	function obj:SetVisible(v) container.Visible = v end
	return obj
end

function Section:CreateColorPicker(cfg)
	cfg = cfg or {}
	local theme = Library.Themes[Library.ActiveTheme]
	local color = cfg.Default or Color3.fromRGB(124, 92, 255)
	local h, s, v = Color3.toHSV(color)

	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		LayoutOrder = self.NextOrder(),
		Parent = self.Container,
	})

	local lbl = create("TextLabel", {
		Size = UDim2.new(1, -80, 1, 0),
		BackgroundTransparency = 1,
		Font = theme.Font,
		Text = cfg.Name or "Color",
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local swatch = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(60, 24),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})
	corner(swatch, 6)
	stroke(swatch, theme.Stroke, 1, 0.4)

	paint(function(t)
		lbl.Font = t.Font; lbl.TextColor3 = t.Text
	end)

	local popup, overlay

	local function close()
		if popup then popup:Destroy(); popup = nil end
		if overlay then overlay:Destroy(); overlay = nil end
	end

	local function fire()
		if cfg.Flag then Library.Flags[cfg.Flag] = color end
		if cfg.Callback then task.spawn(cfg.Callback, color) end
	end

	local function open()
		close()
		local t = Library.Themes[Library.ActiveTheme]
		local parentGui = swatch:FindFirstAncestorOfClass("ScreenGui") or Library.ActiveScreenGui

		overlay = create("TextButton", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
			AutoButtonColor = false, ZIndex = 998, Parent = parentGui,
		})
		overlay.MouseButton1Click:Connect(close)

		popup = create("Frame", {
			Position = UDim2.fromOffset(swatch.AbsolutePosition.X - 180, swatch.AbsolutePosition.Y + swatch.AbsoluteSize.Y + 4),
			Size = UDim2.fromOffset(240, 200),
			BackgroundColor3 = t.Surface, BorderSizePixel = 0, ZIndex = 999, Parent = parentGui,
		})
		corner(popup, 10)
		stroke(popup, t.Stroke, 1, 0.3)
		padding(popup, 10, 10, 10, 10)

		-- Hue slider
		local hueBar = create("Frame", {
			Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 12),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, Parent = popup,
		})
		corner(hueBar, 6)
		create("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0.0, Color3.fromRGB(255, 0, 0)),
				ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
				ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
				ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
				ColorSequenceKeypoint.new(1.0, Color3.fromRGB(255, 0, 0)),
			}),
			Parent = hueBar,
		})

		local hueKnob = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(h, 0, 0.5, 0),
			Size = UDim2.fromOffset(8, 18),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BorderSizePixel = 0,
			Parent = hueBar,
		})
		corner(hueKnob, 3)
		stroke(hueKnob, t.Background, 1, 0)

		-- Saturation/Value area
		local svArea = create("Frame", {
			Position = UDim2.fromOffset(0, 24),
			Size = UDim2.new(1, -60, 1, -80),
			BackgroundColor3 = Color3.fromHSV(h, 1, 1),
			BorderSizePixel = 0, Parent = popup,
		})
		corner(svArea, 6)
		create("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 255, 255)),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = svArea,
		})
		create("UIGradient", {
			Name = "Dark",
			Rotation = 90,
			Color = ColorSequence.new(Color3.fromRGB(0, 0, 0), Color3.fromRGB(0, 0, 0)),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0),
			}),
			Parent = svArea,
		})

		local svKnob = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(s, 1 - v, 0, 0),
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = Color3.fromHSV(h, s, v),
			BorderSizePixel = 0, Parent = svArea,
		})
		corner(svKnob, 6)
		stroke(svKnob, Color3.fromRGB(255, 255, 255), 2, 0)

		-- Hex input
		local hexBox = create("TextBox", {
			Position = UDim2.new(1, -54, 0, 24),
			Size = UDim2.fromOffset(54, 24),
			BackgroundColor3 = t.Element, BorderSizePixel = 0,
			Font = t.Font, Text = "#" .. color:ToHex(),
			TextColor3 = t.Text, TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Center,
			ClearTextOnFocus = false, Parent = popup,
		})
		corner(hexBox, 6)

		-- Preview
		local preview = create("Frame", {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, 0, 1, 0),
			Size = UDim2.fromOffset(50, 40),
			BackgroundColor3 = color, BorderSizePixel = 0, Parent = popup,
		})
		corner(preview, 6)
		stroke(preview, t.Stroke, 1, 0.3)

		local function setColor(newColor, silent)
			color = newColor
			h, s, v = Color3.toHSV(color)
			swatch.BackgroundColor3 = color
			preview.BackgroundColor3 = color
			svArea.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			svKnob.Position = UDim2.new(s, 1 - v, 0, 0)
			svKnob.BackgroundColor3 = color
			hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
			hexBox.Text = "#" .. color:ToHex()
			if not silent then fire() end
		end

		-- Hue drag
		local draggingHue = false
		hueBar.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingHue = true
				local rel = math.clamp((i.Position.X - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1), 0, 1)
				setColor(Color3.fromHSV(rel, s, v))
			end
		end)

		-- SV drag
		local draggingSV = false
		svArea.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSV = true
				local sx = math.clamp((i.Position.X - svArea.AbsolutePosition.X) / math.max(svArea.AbsoluteSize.X, 1), 0, 1)
				local vy = math.clamp((i.Position.Y - svArea.AbsolutePosition.Y) / math.max(svArea.AbsoluteSize.Y, 1), 0, 1)
				setColor(Color3.fromHSV(h, sx, 1 - vy))
			end
		end)

		local conn
		conn = UserInputService.InputChanged:Connect(function(i)
			if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
			if draggingHue then
				local rel = math.clamp((i.Position.X - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1), 0, 1)
				setColor(Color3.fromHSV(rel, s, v))
			elseif draggingSV then
				local sx = math.clamp((i.Position.X - svArea.AbsolutePosition.X) / math.max(svArea.AbsoluteSize.X, 1), 0, 1)
				local vy = math.clamp((i.Position.Y - svArea.AbsolutePosition.Y) / math.max(svArea.AbsoluteSize.Y, 1), 0, 1)
				setColor(Color3.fromHSV(h, sx, 1 - vy))
			end
		end)
		overlay.Destroying:Connect(function() conn:Disconnect() end)
		UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingHue, draggingSV = false, false
			end
		end)

		hexBox.FocusLost:Connect(function()
			local txt = hexBox.Text:gsub("#", "")
			local ok, c = pcall(Color3.fromHex, txt)
			if ok then setColor(c) else hexBox.Text = "#" .. color:ToHex() end
		end)
	end

	track(swatch.MouseButton1Click:Connect(function()
		if popup then close() else open() end
	end))
	attachTooltip(swatch, cfg.Tooltip)

	local obj = { Instance = swatch }
	function obj:Set(c) color = c; swatch.BackgroundColor3 = c; fire() end
	function obj:Get() return color end
	function obj:SetVisible(v) row.Visible = v end
	return obj
end

