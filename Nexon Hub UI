local Section = {}
Section.__index = Section

function Section:CreateLabel(text, color)
	local theme = getTheme()
	local label = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, Font = theme.Font, Text = text or "",
		TextColor3 = color or theme.SubText, TextSize = 12, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = self.NextOrder(), Parent = self.Container,
	})
	paint(function(t) label.Font = t.Font; label.TextColor3 = color or t.SubText end)
	local obj = { Instance = label }
	function obj:Set(t) label.Text = t end
	function obj:SetVisible(v) label.Visible = v end
	return obj
end

function Section:CreateDivider()
	local theme = getTheme()
	local line = create("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = theme.Stroke, BackgroundTransparency = 0.4,
		BorderSizePixel = 0, LayoutOrder = self.NextOrder(), Parent = self.Container,
	})
	paint(function(t) line.BackgroundColor3 = t.Stroke end)
	return { Instance = line }
end

function Section:CreateButton(cfg)
	cfg = cfg or {}
	local theme = getTheme()
	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1,
		LayoutOrder = self.NextOrder(), Parent = self.Container,
	})
	local button = create("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = theme.Element,
		BorderSizePixel = 0, Text = "", AutoButtonColor = false, Parent = row,
	})
	corner(button, 8)
	local s = stroke(button, theme.Stroke, 1, 0.5)
	local label = create("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		Font = theme.FontMedium, Text = cfg.Name or "Button",
		TextColor3 = theme.Text, TextSize = 12, Parent = button,
	})
	paint(function(t)
		button.BackgroundColor3 = t.Element
		label.Font = t.FontMedium; label.TextColor3 = t.Text
		s.Color = t.Stroke
	end)
	track(button.MouseEnter:Connect(function() tween(button, 0.15, { BackgroundColor3 = getTheme().ElementHover }) end))
	track(button.MouseLeave:Connect(function() tween(button, 0.15, { BackgroundColor3 = getTheme().Element }) end))
	track(button.MouseButton1Click:Connect(function()
		if cfg.Callback then task.spawn(cfg.Callback) end
	end))
	attachTooltip(button, cfg.Tooltip)
	local obj = { Instance = button }
	function obj:SetText(t) label.Text = t end
	function obj:SetVisible(v) row.Visible = v end
	return obj
end

