				Position = UDim2.fromOffset(6, 0), Size = UDim2.fromOffset(14, 26),
				BackgroundTransparency = 1, Font = theme.FontBold,
				Text = selected[option] and "✓" or "",
				TextColor3 = theme.Accent, TextSize = 12, Parent = optBtn,
			})
			create("TextLabel", {
				Position = UDim2.fromOffset(24, 0), Size = UDim2.new(1, -30, 1, 0),
				BackgroundTransparency = 1, Font = theme.Font,
