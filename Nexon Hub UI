		DisplayOrder = 1000,
	})
	setGuiParent(gui)
	table.insert(self._destroyers, gui)

	local frame = create("Frame", {
		Name = "Watermark",
		Position = UDim2.new(0, 20, 0, 20),
		Size = UDim2.fromOffset(220, 30),
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		Parent = gui,
	})
	corner(frame, 8)
	local s = stroke(frame, theme.Stroke, 1, 0.3)
	padding(frame, 0, 10, 0, 10)

	local title = create("TextLabel", {
		Size = UDim2.new(1, -80, 1, 0),
		BackgroundTransparency = 1,
		Font = theme.FontBold,
		Text = cfg.Title or ("Nexon Hub v" .. self.Version),
		TextColor3 = theme.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})

	local user = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(100, 30),
		BackgroundTransparency = 1,
		Font = theme.FontMedium,
		Text = LocalPlayer.DisplayName or LocalPlayer.Name,
		TextColor3 = theme.SubText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = frame,
	})

	paint(function(t)
		frame.BackgroundColor3 = t.Surface
		s.Color = t.Stroke
		title.Font = t.FontBold; title.TextColor3 = t.Text
		user.Font = t.FontMedium; user.TextColor3 = t.SubText
	end)

	-- Draggable
	local dragging, dragStart, startPos
	track(frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end))

	return { Instance = frame }
end

