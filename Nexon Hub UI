local notifyGui, notifyHolder
local NotifyTypes = {
	Info    = { Icon = "i", Color = nil },
	Success = { Icon = "v", Color = Color3.fromRGB(74, 222, 128) },
	Warning = { Icon = "!", Color = Color3.fromRGB(250, 204, 21) },
	Error   = { Icon = "x", Color = Color3.fromRGB(255, 84, 96) },
}

local function getNotifyHolder()
	if notifyGui and notifyGui.Parent and notifyHolder and notifyHolder.Parent then
		return notifyHolder
	end
	notifyGui = create("ScreenGui", {
		Name = "NexonHubNotifications",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		DisplayOrder = 1000,
	})
	setGuiParent(notifyGui)
	table.insert(Library._destroyers, notifyGui)
	notifyHolder = create("Frame", {
		Name = "Holder",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20),
		Size = UDim2.fromOffset(280, 500),
		BackgroundTransparency = 1,
		Parent = notifyGui,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Parent = notifyHolder,
	})
	return notifyHolder
end

local _notifyOrder = 0
function Library:Notify(cfg)
	if type(cfg) == "string" then cfg = { Text = cfg } end
	cfg = cfg or {}
	local theme = getTheme()
	local holder = getNotifyHolder()
	local ntype = NotifyTypes[cfg.Type or "Info"] or NotifyTypes.Info
	local accent = cfg.Accent or ntype.Color or theme.Accent
	local duration = cfg.Duration or 4
	_notifyOrder += 1

	local card = create("CanvasGroup", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		LayoutOrder = _notifyOrder,
		Parent = holder,
	})
	corner(card, 10)
	stroke(card, theme.Stroke, 1, 0.3)

	local inner = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = card,
	})
	padding(inner, 10, 10, 10, 12)
	create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = inner })

	local titleRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1, LayoutOrder = 1, Parent = inner,
	})

	create("TextLabel", {
		Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1,
		Font = theme.FontBold, Text = ntype.Icon, TextColor3 = accent, TextSize = 13,
		Parent = titleRow,
	})

	create("TextLabel", {
		Position = UDim2.fromOffset(18, 0),
		Size = UDim2.new(1, -36, 1, 0), BackgroundTransparency = 1,
		Font = theme.FontBold, Text = cfg.Title or "Notification",
		TextColor3 = theme.Text, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = titleRow,
	})

	local closeBtn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1,
		Text = "x", Font = theme.FontBold, TextColor3 = theme.SubText, TextSize = 12,
		AutoButtonColor = false, Parent = titleRow,
	})

	create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, Font = theme.Font, Text = cfg.Text or "",
		TextColor3 = theme.SubText, TextSize = 11, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 2, Parent = inner,
	})

	tween(card, 0.25, { GroupTransparency = 0 })

	local closed = false
	local function dismiss()
		if closed then return end
		closed = true
		local fade = tween(card, 0.2, { GroupTransparency = 1 })
		fade.Completed:Wait()
		card:Destroy()
	end
	closeBtn.MouseButton1Click:Connect(dismiss)
	if duration > 0 then task.delay(duration, dismiss) end
	if cfg.OnClick then
		card.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				task.spawn(cfg.OnClick); dismiss()
			end
		end)
	end
	return card
end

