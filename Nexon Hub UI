function Section:CreateKeybind(cfg)
	cfg = cfg or {}
	local theme = getTheme()
	local key = cfg.Default or Enum.KeyCode.Unknown
	local listening = false

	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1,
		LayoutOrder = self.NextOrder(), Parent = self.Container,
	})
	local lbl = create("TextLabel", {
		Size = UDim2.new(1, -110, 1, 0), BackgroundTransparency = 1,
		Font = theme.Font, Text = cfg.Name or "Keybind",
		TextColor3 = theme.Text, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
	local button = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(100, 24), BackgroundColor3 = theme.Element,
		BorderSizePixel = 0, Text = (key ~= Enum.KeyCode.Unknown) and key.Name or "None",
		Font = theme.FontMedium, TextColor3 = theme.Text, TextSize = 11,
		AutoButtonColor = false, Parent = row,
	})
	corner(button, 6)
	local btnStroke = stroke(button, theme.Stroke, 1, 0.5)
	paint(function(t)
		lbl.Font = t.Font; lbl.TextColor3 = t.Text
		button.BackgroundColor3 = t.Element; button.Font = t.FontMedium
		button.TextColor3 = t.Text; btnStroke.Color = t.Stroke
	end)

	track(button.MouseButton1Click:Connect(function()
		listening = true
		button.Text = "..."
		tween(btnStroke, 0.15, { Color = getTheme().Accent, Transparency = 0 })
	end))

	track(UserInputService.InputBegan:Connect(function(input, gp)
		if listening then
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			listening = false
			key = input.KeyCode
			button.Text = key.Name
			tween(btnStroke, 0.15, { Color = getTheme().Stroke, Transparency = 0.5 })
			if cfg.Flag then Library.Flags[cfg.Flag] = key end
			if cfg.Callback then task.spawn(cfg.Callback, key) end
			return
		end
		if gp then return end
		if input.KeyCode == key and key ~= Enum.KeyCode.Unknown then
			if cfg.Mode == "Toggle" then
				cfg._toggled = not cfg._toggled
				if cfg.Callback then task.spawn(cfg.Callback, cfg._toggled) end
			elseif cfg.Mode ~= "Hold" then
				if cfg.Callback then task.spawn(cfg.Callback, true) end
			end
		end
	end))

	track(UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == key and key ~= Enum.KeyCode.Unknown and cfg.Mode == "Hold" then
			if cfg.Callback then task.spawn(cfg.Callback, false) end
		end
	end))

	attachTooltip(button, cfg.Tooltip)
	local obj = { Instance = button }
	function obj:Set(k)
		key = k
		button.Text = (k ~= Enum.KeyCode.Unknown) and k.Name or "None"
	end
	function obj:Get() return key end
	function obj:SetVisible(v) row.Visible = v end
	return obj
end

