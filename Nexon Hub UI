function Section:CreateSlider(cfg)
	cfg = cfg or {}
	local theme = Library.Themes[Library.ActiveTheme]
	local min, max = cfg.Min or 0, cfg.Max or 100
	local step = cfg.Step or 1
	local value = math.clamp(cfg.Default or min, min, max)

	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		LayoutOrder = self.NextOrder(),
		Parent = self.Container,
	})

	local lbl = create("TextLabel", {
		Size = UDim2.new(1, -70, 0, 18),
		BackgroundTransparency = 1,
		Font = theme.Font,
		Text = cfg.Name or "Slider",
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local valueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(70, 18),
		BackgroundTransparency = 1,
		Font = theme.FontMedium,
		Text = tostring(value),
		TextColor3 = theme.SubText,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	local bar = create("Frame", {
		Position = UDim2.new(0, 0, 0, 28),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		Parent = row,
	})
	corner(bar, 3)

	local fill = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		Parent = bar,
	})
	corner(fill, 3)

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Parent = bar,
	})
	corner(knob, 7)

	local hitbox = create("TextButton", {
		Position = UDim2.new(0, 0, 0, 18),
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})

	local dragging = false
	local dragConn

	local function setValue(v, silent)
		v = math.clamp(v, min, max)
		local steps = math.floor((v - min) / step + 0.5)
		v = min + steps * step
		v = tonumber(string.format("%.4f", v)) or v
		value = v
		local alpha = (max - min == 0) and 0 or (v - min) / (max - min)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		valueLabel.Text = tostring(v)
		if cfg.Flag then Library.Flags[cfg.Flag] = v end
		if not silent and cfg.Callback then task.spawn(cfg.Callback, v) end
	end

	local function updateFromX(x)
		local width = math.max(bar.AbsoluteSize.X, 1)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / width, 0, 1)
		setValue(min + (max - min) * rel)
	end

	setValue(value, true)
	paint(function(t)
		lbl.Font = t.Font; lbl.TextColor3 = t.Text
		valueLabel.Font = t.FontMedium; valueLabel.TextColor3 = t.SubText
		bar.BackgroundColor3 = t.Element
		fill.BackgroundColor3 = t.Accent
	end)

	track(hitbox.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromX(input.Position.X)
			-- Scoped listener — no leak
			dragConn = UserInputService.InputChanged:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseMovement
					or i.UserInputType == Enum.UserInputType.Touch then
					updateFromX(i.Position.X)
				end
			end)
		end
	end))

	track(hitbox.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			if dragConn then dragConn:Disconnect(); dragConn = nil end
		end
	end))

	attachTooltip(hitbox, cfg.Tooltip)

	local obj = { Instance = bar }
	function obj:Set(v) setValue(v) end
	function obj:Get() return value end
	function obj:Reset() setValue(cfg.Default or min) end
	function obj:SetVisible(v) row.Visible = v end
	return obj
end

