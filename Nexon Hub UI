--  TOOLTIP
--==================================================================
local tooltipGui, tooltipFrame
local function showTooltip(anchor, text)
	if tooltipGui and tooltipGui.Parent then tooltipGui:Destroy() end
	local theme = Library.Themes[Library.ActiveTheme]

	tooltipGui = create("ScreenGui", {
		Name = "NexonHubTooltip",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		DisplayOrder = 999,
	})
	setGuiParent(tooltipGui)

	tooltipFrame = create("Frame", {
		Position = UDim2.fromOffset(anchor.AbsolutePosition.X + 10, anchor.AbsolutePosition.Y + anchor.AbsoluteSize.Y + 6),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		Parent = tooltipGui,
	})
	corner(tooltipFrame, 6)
	stroke(tooltipFrame, theme.Stroke, 1, 0.3)
	padding(tooltipFrame, 6, 10, 6, 10)

	create("TextLabel", {
		Size = UDim2.new(0, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 1,
		Font = theme.Font,
		Text = text,
		TextColor3 = theme.Text,
		TextSize = 11,
		TextWrapped = true,
		Parent = tooltipFrame,
	})
end

local function hideTooltip()
	if tooltipGui then tooltipGui:Destroy(); tooltipGui = nil end
end

local function attachTooltip(target, text)
	if not text then return end
	track(target.MouseEnter:Connect(function() showTooltip(target, text) end))
	track(target.MouseLeave:Connect(hideTooltip))
end

