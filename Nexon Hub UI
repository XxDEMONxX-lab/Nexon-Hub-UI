		Text = cfg.Name or "Input",
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local box = create("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(170, 28),
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		Font = theme.Font,
		PlaceholderText = cfg.Placeholder or "Enter text...",
		PlaceholderColor3 = theme.SubText,
		Text = cfg.Default or "",
		TextColor3 = theme.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Parent = row,
	})
	corner(box, 6)
	local boxStroke = stroke(box, theme.Stroke, 1, 0.5)
	padding(box, 0, 8, 0, 8)

	paint(function(t)
		lbl.Font = t.Font; lbl.TextColor3 = t.Text
		box.BackgroundColor3 = t.Element; box.Font = t.Font
		box.PlaceholderColor3 = t.SubText; box.TextColor3 = t.Text
		boxStroke.Color = t.Stroke
	end)

	local debounceToken = 0
	track(box.Focused:Connect(function()
		tween(boxStroke, 0.15, { Color = Library.Themes[Library.ActiveTheme].Accent, Transparency = 0 })
	end))
	track(box.FocusLost:Connect(function(enterPressed)
		tween(boxStroke, 0.15, { Color = Library.Themes[Library.ActiveTheme].Stroke, Transparency = 0.5 })
		if cfg.Flag then Library.Flags[cfg.Flag] = box.Text end
		-- Debounced callback
		debounceToken += 1
		local myToken = debounceToken
		task.delay(cfg.Debounce or 0, function()
			if myToken == debounceToken and cfg.Callback then
				task.spawn(cfg.Callback, box.Text, enterPressed)
			end
		end)
	end))

	attachTooltip(box, cfg.Tooltip)

	local obj = { Instance = box }
	function obj:Set(t) box.Text = t end
	function obj:Get() return box.Text end
	function obj:SetVisible(v) row.Visible = v end
	return obj
end

