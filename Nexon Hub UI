	})
	create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1,
		Font = theme.FontBold, Text = "v", TextColor3 = theme.SubText,
		TextSize = 12, Parent = display,
	})

	local function refreshLabel()
		local list = {}
		for _, o in ipairs(options) do if selected[o] then table.insert(list, tostring(o)) end end
		valueText.Text = (#list == 0) and "None selected" or table.concat(list, ", ")
	end
	local function fire()
		local list = {}
		for _, o in ipairs(options) do if selected[o] then table.insert(list, o) end end
		if cfg.Flag then Library.Flags[cfg.Flag] = list end
		if cfg.Callback then task.spawn(cfg.Callback, list) end
	end

	paint(function(t)
		lbl.Font = t.Font; lbl.TextColor3 = t.Text
		display.BackgroundColor3 = t.Element
		valueText.Font = t.Font; valueText.TextColor3 = t.Text
		displayStroke.Color = t.Stroke
	end)

	track(display.MouseEnter:Connect(function() tween(display, 0.15, { BackgroundColor3 = getTheme().ElementHover }) end))
	track(display.MouseLeave:Connect(function() tween(display, 0.15, { BackgroundColor3 = getTheme().Element }) end))

	local popup, overlay
	local function close()
		if popup then popup:Destroy(); popup = nil end
		if overlay then overlay:Destroy(); overlay = nil end
	end

	local function open()
		close()
		local t = getTheme()
		local parentGui = display:FindFirstAncestorOfClass("ScreenGui") or Library.ActiveScreenGui
		overlay = create("TextButton", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			Text = "", AutoButtonColor = false, ZIndex = 998, Parent = parentGui,
		})
		overlay.MouseButton1Click:Connect(close)

		local listH = math.min(#options * 26 + 8, 160)
		local screenH = parentGui.AbsoluteSize.Y
		local below = display.AbsolutePosition.Y + display.AbsoluteSize.Y + 4
		local above = display.AbsolutePosition.Y - listH - 4
		local py = (below + listH > screenH) and above or below

		popup = create("Frame", {
			Position = UDim2.fromOffset(display.AbsolutePosition.X, py),
			Size = UDim2.fromOffset(display.AbsoluteSize.X, listH),
			BackgroundColor3 = t.Surface, BorderSizePixel = 0,
			ZIndex = 999, Parent = parentGui,
		})
		corner(popup, 6)
		stroke(popup, t.Stroke, 1, 0.3)
		local list = create("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			BorderSizePixel = 0, ScrollBarThickness = 3,
			ScrollBarImageColor3 = t.Stroke,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y, Parent = popup,
		})
		padding(list, 4, 4, 4, 4)
		create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

		for i, option in ipairs(options) do
			local optBtn = create("TextButton", {
				Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = t.ElementHover,
				BackgroundTransparency = 1, BorderSizePixel = 0, Text = "",
				AutoButtonColor = false, LayoutOrder = i, Parent = list,
			})
			corner(optBtn, 5)
			local check = create("TextLabel", {
				Position = UDim2.fromOffset(6, 0), Size = UDim2.fromOffset(14, 24),
				BackgroundTransparency = 1, Font = t.FontBold,
				Text = selected[option] and "x" or "",
				TextColor3 = t.Accent, TextSize = 11, Parent = optBtn,
			})
			create("TextLabel", {
				Position = UDim2.fromOffset(24, 0),
				Size = UDim2.new(1, -30, 1, 0), BackgroundTransparency = 1,
				Font = t.Font, Text = tostring(option),
				TextColor3 = selected[option] and t.Accent or t.Text,
				TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd, Parent = optBtn,
			})
			optBtn.MouseEnter:Connect(function() tween(optBtn, 0.12, { BackgroundTransparency = 0 }) end)
			optBtn.MouseLeave:Connect(function() tween(optBtn, 0.12, { BackgroundTransparency = 1 }) end)
			optBtn.MouseButton1Click:Connect(function()
				selected[option] = not selected[option]
				check.Text = selected[option] and "x" or ""
				refreshLabel()
				fire()
			end)
		end
	end

	refreshLabel()
	track(display.MouseButton1Click:Connect(function()
		if popup then close() else open() end
	end))
	attachTooltip(display, cfg.Tooltip)

	local obj = { Instance = display }
	function obj:Set(list)
		selected = {}
		for _, v in ipairs(list or {}) do selected[v] = true end
		refreshLabel(); fire()
	end
	function obj:Get()
		local list = {}
		for _, o in ipairs(options) do if selected[o] then table.insert(list, o) end end
		return list
	end
	function obj:SetVisible(v) row.Visible = v end
	return obj
end

