--==================================================================
--  GUI PARENT RESOLUTION
--==================================================================
local GuiParent = (function()
	if gethui then
		local ok, res = pcall(gethui)
		if ok and res then return res end
	end
	local ok, res = pcall(function() return game:GetService("CoreGui") end)
	if ok and res then return res end
	return LocalPlayer:WaitForChild("PlayerGui")
end)()

local function setGuiParent(gui)
	local ok = pcall(function() gui.Parent = GuiParent end)
	if not ok or not gui.Parent then
		gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	end
end

--==================================================================
--  HELPERS
--==================================================================
local function create(className, props, children)
	local inst = Instance.new(className)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v
		else inst[k] = v end
	end
	for _, child in ipairs(children or {}) do child.Parent = inst end
	if parent then inst.Parent = parent end
	return inst
end

local function corner(obj, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 8), Parent = obj })
end

local function stroke(obj, color, thickness, transparency)
	return create("UIStroke", {
		Color = color or Library.Themes[Library.ActiveTheme].Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = obj,
	})
end

local function padding(obj, top, right, bottom, left)
	top = top or 0; right = right or top; bottom = bottom or top; left = left or right
	return create("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom),
		PaddingLeft = UDim.new(0, left),
		Parent = obj,
	})
end

local function tween(obj, time, props, style, dir)
	local info = TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

-- Register a connection for global cleanup
local function track(conn)
	table.insert(Library._connections, conn)
	return conn
end

-- Register a themed painter (called whenever theme changes)
local function paint(fn)
	table.insert(Library._painters, fn)
	fn(Library.Themes[Library.ActiveTheme])
end

--==================================================================
--  THEME MANAGER
--==================================================================
function Library:SetTheme(name)
	if type(name) == "table" then
		self.Themes[name.Name or "Custom"] = name
		name = name.Name or "Custom"
	end
	if not self.Themes[name] then
		warn("[NexonHub] Unknown theme: " .. tostring(name))
		return
	end
	self.ActiveTheme = name
	local theme = self.Themes[name]
	for _, fn in ipairs(self._painters) do
		pcall(fn, theme)
	end
end

function Library:GetTheme(name)
	return self.Themes[name or self.ActiveTheme]
end

--==================================================================
--  CONFIG (save / load)
--==================================================================
local hasFS = (typeof(writefile) == "function") and (typeof(readfile) == "function")

function Library:SaveConfig(path)
	path = path or "nexonhub_config.json"
	if not hasFS then
		warn("[NexonHub] No filesystem available; cannot save.")
		return false
	end
	local data = { theme = self.ActiveTheme, flags = {} }
	for k, v in pairs(self.Flags) do
		local t = typeof(v)
		if t == "boolean" or t == "number" or t == "string" then
			data.flags[k] = v
		elseif t == "EnumItem" then
			data.flags[k] = tostring(v)
		end
	end
	local ok, encoded = pcall(function() return game:GetService("HttpService"):JSONEncode(data) end)
	if not ok then return false end
	pcall(writefile, path, encoded)
	return true
end

function Library:LoadConfig(path)
	path = path or "nexonhub_config.json"
	if not hasFS then return false end
	local ok, raw = pcall(readfile, path)
	if not ok or not raw then return false end
	local ok2, data = pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
	if not ok2 or type(data) ~= "table" then return false end
	if data.theme then self:SetTheme(data.theme) end
	if data.flags then
		for k, v in pairs(data.flags) do
			self.Flags[k] = v
		end
	end
	return true
end

