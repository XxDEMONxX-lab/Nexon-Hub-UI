end

function Section:CreateButton(cfg)
	cfg = cfg or {}
	local theme = Library.Themes[Library.ActiveTheme]

	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 1,
		LayoutOrder = self.NextOrder(),
		Parent = self.Container,
	})

	local button = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})
	corner(button, 8)
	local s = stroke(button, theme.Stroke, 1, 0.5)

	local label = create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = theme.FontMedium,
		Text = cfg.Name or "Button",
		TextColor3 = theme.Text,
		TextSize = 13,
		Parent = button,
	})

	paint(function(t)
		button.BackgroundColor3 = t.Element
		label.Font = t.FontMedium
		label.TextColor3 = t.Text
		s.Color = t.Stroke
	end)

	track(button.MouseEnter:Connect(function()
		tween(button, 0.15, { BackgroundColor3 = Library.Themes[Library.ActiveTheme].ElementHover })
	end))
	track(button.MouseLeave:Connect(function()
		tween(button, 0.15, { BackgroundColor3 = Library.Themes[Library.ActiveTheme].Element })
	end))
	track(button.MouseButton1Down:Connect(function()
		tween(label, 0.08, { TextColor3 = Library.Themes[Library.ActiveTheme].Accent })
	end))
	track(button.MouseButton1Click:Connect(function()
		tween(label, 0.15, { TextColor3 = Library.Themes[Library.ActiveTheme].Text })
		if cfg.Callback then task.spawn(cfg.Callback) end
	end))

	attachTooltip(button, cfg.Tooltip)

	local obj = { Instance = button }
	function obj:SetText(t) label.Text = t end
	function obj:SetVisible(v) row.Visible = v end
	return obj
end

function Section:CreateToggle(cfg)
	cfg = cfg or {}
	local theme = Library.Themes[Library.ActiveTheme]

	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		LayoutOrder = self.NextOrder(),
		Parent = self.Container,
	})

	local lbl = create("TextLabel", {
		Size = UDim2.new(1, -60, 1, 0),
		BackgroundTransparency = 1,
		Font = theme.Font,
		Text = cfg.Name or "Toggle",
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local switch = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(38, 20),
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		Parent = row,
	})
	corner(switch, 10)

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = theme.SubText,
		BorderSizePixel = 0,
		Parent = switch,
	})
	corner(knob, 8)

	local hitbox = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})

	local value = cfg.Default == true

	local function apply(v, silent)
		value = v and true or false
		local t = Library.Themes[Library.ActiveTheme]
		tween(switch, 0.18, { BackgroundColor3 = value and t.Accent or t.Element })
		tween(knob, 0.18, {
			Position = value and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
			BackgroundColor3 = value and Color3.fromRGB(255, 255, 255) or t.SubText,
		})
		if cfg.Flag then Library.Flags[cfg.Flag] = value end
		if not silent and cfg.Callback then task.spawn(cfg.Callback, value) end
	end

	apply(value, true)
	paint(function(t)
		lbl.Font = t.Font; lbl.TextColor3 = t.Text
		if not value then switch.BackgroundColor3 = t.Element; knob.BackgroundColor3 = t.SubText
		else switch.BackgroundColor3 = t.Accent end
	end)

