function Section:CreateSearchBox(cfg)
	cfg = cfg or {}
	local theme = getTheme()
	local box = create("TextBox", {
		Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = theme.Element,
		BorderSizePixel = 0, Font = theme.Font,
		PlaceholderText = cfg.Placeholder or "Search...",
		PlaceholderColor3 = theme.SubText, Text = "",
		TextColor3 = theme.Text, TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false, LayoutOrder = self.NextOrder(), Parent = self.Container,
	})
	corner(box, 6)
	stroke(box, theme.Stroke, 1, 0.5)
	padding(box, 0, 10, 0, 10)
	paint(function(t)
		box.BackgroundColor3 = t.Element; box.Font = t.Font
		box.PlaceholderColor3 = t.SubText; box.TextColor3 = t.Text
	end)
	local function filter(term)
		term = string.lower(term)
		for _, child in ipairs(self.Container:GetChildren()) do
			if child:IsA("GuiObject") and child ~= box then
				local label
				if child:IsA("TextLabel") or child:IsA("TextButton") then
					label = child.Text
				else
					local t = child:FindFirstChildWhichIsA("TextLabel")
					label = t and t.Text or nil
				end
				if not label then child.Visible = true
				else child.Visible = (term == "") or string.find(string.lower(label), term, 1, true) ~= nil end
			end
		end
	end
	track(box:GetPropertyChangedSignal("Text"):Connect(function()
		filter(box.Text)
		if cfg.Callback then task.spawn(cfg.Callback, box.Text) end
	end))
	local obj = { Instance = box }
	function obj:Set(t) box.Text = t end
	function obj:Get() return box.Text end
	return obj
end

