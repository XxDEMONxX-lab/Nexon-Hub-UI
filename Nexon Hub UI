local notifyGui, notifyHolder

local NotifyTypes = {
	Info    = { Icon = "ℹ", Color = nil },        -- uses theme accent
	Success = { Icon = "✓", Color = Color3.fromRGB(74, 222, 128) },
	Warning = { Icon = "!", Color = Color3.fromRGB(250, 204, 21) },
	Error   = { Icon = "×", Color = Color3.fromRGB(255, 84, 96) },
}

local function getNotifyHolder()
	if notifyGui and notifyGui.Parent and notifyHolder and notifyHolder.Parent then
		return notifyHolder
	end
	notifyGui = create("ScreenGui", {
		Name = "NexonHubNotifications",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		DisplayOrder = 1000,
	})
	setGuiParent(notifyGui)
	table.insert(Library._destroyers, notifyGui)

	notifyHolder = create("Frame", {
		Name = "Holder",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20),
		Size = UDim2.fromOffset(300, 500),
		BackgroundTransparency = 1,
		Parent = notifyGui,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Parent = notifyHolder,
	})
	return notifyHolder
end

local _notifyOrder = 0
function Library:Notify(cfg)
	if type(cfg) == "string" then cfg = { Text = cfg } end
	cfg = cfg or {}

	local theme = self.Themes[self.ActiveTheme]
	local holder = getNotifyHolder()
	local ntype = NotifyTypes[cfg.Type or "Info"] or NotifyTypes.Info
	local accent = cfg.Accent or ntype.Color or theme.Accent
	local duration = cfg.Duration or 4

	_notifyOrder += 1

	local card = create("CanvasGroup", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		LayoutOrder = _notifyOrder,
		Parent = holder,
	})
	corner(card, 10)
	stroke(card, theme.Stroke, 1, 0.3)

	local inner = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = card,
	})
	padding(inner, 12, 12, 12, 14)
	create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = inner })

	local titleRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1, LayoutOrder = 1, Parent = inner,
	})

	create("TextLabel", {
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(16, 18),
		BackgroundTransparency = 1,
		Font = theme.FontBold,
		Text = ntype.Icon,
		TextColor3 = accent,
		TextSize = 14,
		Parent = titleRow,
	})

	create("TextLabel", {
		Position = UDim2.fromOffset(18, 0),
		Size = UDim2.new(1, -36, 1, 0),
		BackgroundTransparency = 1,
		Font = theme.FontBold,
		Text = cfg.Title or "Notification",
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = titleRow,
	})

	local closeBtn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		Text = "×",
		Font = theme.FontBold,
		TextColor3 = theme.SubText,
		TextSize = 14,
		AutoButtonColor = false,
		Parent = titleRow,
	})

	local msg = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = theme.Font,
		Text = cfg.Text or "",
		TextColor3 = theme.SubText,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 2,
		Parent = inner,
	})

	-- Progress bar (auto-dismiss indicator)
	local progressTrack = create("Frame", {
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = theme.Stroke,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		LayoutOrder = 3,
		Parent = inner,
	})
	corner(progressTrack, 2)

	local progressFill = create("Frame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		Parent = progressTrack,
	})
	corner(progressFill, 2)

	tween(card, 0.25, { GroupTransparency = 0 })

	local closed = false
	local function dismiss()
		if closed then return end
		closed = true
		local fade = tween(card, 0.2, { GroupTransparency = 1 })
		fade.Completed:Wait()
		card:Destroy()
	end

	closeBtn.MouseButton1Click:Connect(dismiss)

	if duration > 0 then
		tween(progressFill, duration, { Size = UDim2.new(0, 0, 1, 0) }, Enum.EasingStyle.Linear)
		task.delay(duration, dismiss)
	else
		progressTrack.Visible = false
	end

	if cfg.OnClick then
		card.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				task.spawn(cfg.OnClick)
				dismiss()
			end
		end)
	end

	return card
end

